{% extends 'base.html.twig' %}

{% block title %}Accueil - SIGEANSUD{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <div class="mb-3">
        <i class="bi bi-tree" style="font-size: 4rem; background: linear-gradient(135deg, #e67e22, #d35400); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"></i>
    </div>
    <h2 style="font-size: 2rem;">Bienvenue sur le Back-office</h2>
    <p class="text-muted">Gestion du parc animalier SIGEANSUD</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-4 col-md-6">
        <a href="{{ path('soignant_index') }}" class="text-decoration-none">
            <div class="card dashboard-card text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                             style="width: 70px; height: 70px; background: rgba(52, 152, 219, 0.1);">
                            <i class="bi bi-people" style="font-size: 2rem; color: #3498db;"></i>
                        </div>
                    </div>
                    <div class="dashboard-number">{{ nbSoignants }}</div>
                    <p class="text-muted mt-1 mb-0">Soignants</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-lg-4 col-md-6">
        <a href="{{ path('espece_index') }}" class="text-decoration-none">
            <div class="card dashboard-card text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                             style="width: 70px; height: 70px; background: rgba(46, 204, 113, 0.1);">
                            <i class="bi bi-bug" style="font-size: 2rem; color: #27ae60;"></i>
                        </div>
                    </div>
                    <div class="dashboard-number">{{ nbEspeces }}</div>
                    <p class="text-muted mt-1 mb-0">Especes</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-lg-4 col-md-6">
        <a href="{{ path('menu_index') }}" class="text-decoration-none">
            <div class="card dashboard-card text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle"
                             style="width: 70px; height: 70px; background: rgba(230, 126, 34, 0.1);">
                            <i class="bi bi-cup-straw" style="font-size: 2rem; color: #e67e22;"></i>
                        </div>
                    </div>
                    <div class="dashboard-number">{{ nbMenus }}</div>
                    <p class="text-muted mt-1 mb-0">Menus</p>
                </div>
            </div>
        </a>
    </div>
</div>
{% endblock %}
