<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SIGEANSUD - Back-office{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1a2332;
            --primary-light: #243447;
            --accent: #e67e22;
            --accent-hover: #d35400;
            --accent-light: rgba(230, 126, 34, 0.1);
            --success: #27ae60;
            --danger: #e74c3c;
            --text: #2c3e50;
            --text-muted: #7f8c8d;
            --bg: #f0f2f5;
            --card-bg: #ffffff;
            --border: #e8ecf1;
        }

        html { height: 100%; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            min-height: 100%;
            display: flex;
            flex-direction: column;
            color: var(--text);
        }

        /* === NAVBAR === */
        .navbar {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%) !important;
            padding: 0.8rem 0;
            box-shadow: 0 2px 20px rgba(0,0,0,0.15);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--accent) !important;
            letter-spacing: 0.5px;
        }
        .navbar-brand i { margin-right: 4px; }
        .nav-link {
            color: rgba(255,255,255,0.7) !important;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: all 0.2s ease;
            margin: 0 2px;
        }
        .nav-link:hover { color: #fff !important; background: rgba(255,255,255,0.1); }
        .nav-link.active { color: var(--accent) !important; background: rgba(230,126,34,0.15); }
        .dropdown-menu {
            border: none;
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
            border-radius: 12px;
            padding: 0.5rem;
        }
        .dropdown-item {
            border-radius: 8px;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
        }
        .dropdown-item:hover { background-color: var(--bg); }

        /* === CARDS === */
        .card {
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background: var(--card-bg);
        }
        .card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border);
            font-weight: 600;
            padding: 1.2rem 1.5rem;
        }

        /* === BUTTONS === */
        .btn {
            border-radius: 10px;
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 1.2rem;
            transition: all 0.2s ease;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            border: none;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary) 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(26,35,50,0.3);
        }
        .btn-warning {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }
        .btn-warning:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
            color: #fff;
        }
        .btn-secondary {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-muted);
        }
        .btn-secondary:hover {
            background: var(--bg);
            border-color: var(--text-muted);
            color: var(--text);
        }
        .btn-group .btn { border-radius: 8px; margin: 0 1px; }
        .btn-sm { padding: 0.35rem 0.8rem; font-size: 0.82rem; }

        /* === TABLES === */
        .table { margin-bottom: 0; }
        .table th {
            background: var(--primary);
            color: white;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 1.2rem;
            border: none;
        }
        .table th:first-child { border-radius: 12px 0 0 0; }
        .table th:last-child { border-radius: 0 12px 0 0; }
        .table td {
            padding: 0.9rem 1.2rem;
            vertical-align: middle;
            border-color: var(--border);
        }
        .table-hover tbody tr:hover { background-color: var(--accent-light); }

        /* === FORMS === */
        .form-control, .form-select {
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.6rem 1rem;
            font-size: 0.9rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(230,126,34,0.15);
        }
        .form-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text);
            margin-bottom: 0.4rem;
        }

        /* === BADGES === */
        .badge {
            font-weight: 500;
            font-size: 0.78rem;
            padding: 0.4em 0.8em;
            border-radius: 8px;
        }

        /* === ALERTS === */
        .alert {
            border: none;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* === HERO === */
        .hero-icon {
            font-size: 3rem;
            background: linear-gradient(135deg, var(--accent), var(--accent-hover));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .dashboard-card {
            border-radius: 16px;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            cursor: pointer;
            overflow: hidden;
        }
        .dashboard-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.1);
        }
        .dashboard-card .card-body { padding: 2rem; }
        .dashboard-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary);
            line-height: 1;
        }

        /* === ESPECE CARDS === */
        .espece-card {
            transition: transform 0.2s ease;
            overflow: hidden;
        }
        .espece-card:hover { transform: translateY(-4px); }

        /* === FOOTER === */
        footer {
            background: var(--primary) !important;
            padding: 1.2rem 0;
            font-size: 0.85rem;
        }

        /* === PAGE TITLE === */
        h2 {
            font-weight: 700;
            font-size: 1.6rem;
            color: var(--primary);
        }
        h2 i { color: var(--accent); margin-right: 6px; }

        /* === PROFIL AVATAR === */
        .avatar-circle {
            width: 80px;
            height: 80px;
            font-size: 1.8rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
        }

        /* === SCROLLBAR === */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: #c0c5cc; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #a0a7b0; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="{{ path('dashboard') }}">
                <i class="bi bi-tree"></i> SIGEANSUD
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'dashboard' %}active{% endif %}"
                           href="{{ path('dashboard') }}">
                            <i class="bi bi-house"></i> Accueil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if 'soignant' in app.request.attributes.get('_route', '') %}active{% endif %}"
                           href="{{ path('soignant_index') }}">
                            <i class="bi bi-people"></i> Soignants
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if 'espece' in app.request.attributes.get('_route', '') %}active{% endif %}"
                           href="{{ path('espece_index') }}">
                            <i class="bi bi-bug"></i> Especes
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if 'menu' in app.request.attributes.get('_route', '') %}active{% endif %}"
                           href="{{ path('menu_index') }}">
                            <i class="bi bi-cup-straw"></i> Menus
                        </a>
                    </li>
                    {% if app.session.get('gestionnaire') and app.session.get('gestionnaire').role == 'admin' %}
                    <li class="nav-item">
                        <a class="nav-link {% if 'gestionnaire' in app.request.attributes.get('_route', '') %}active{% endif %}"
                           href="{{ path('gestionnaire_index') }}">
                            <i class="bi bi-shield-lock"></i> Gestionnaires
                        </a>
                    </li>
                    {% endif %}
                </ul>
                {% if app.session.get('gestionnaire') %}
                <ul class="navbar-nav ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            {{ app.session.get('gestionnaire').prenom|first }}. {{ app.session.get('gestionnaire').nom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('profil') }}">
                                    <i class="bi bi-person"></i> Mon profil
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('logout') }}">
                                    <i class="bi bi-box-arrow-right"></i> Deconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container mb-5 flex-grow-1">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>

    <footer class="text-white text-center py-3 mt-auto">
        <small>&copy; 2026 SIGEANSUD - Parc animalier</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
